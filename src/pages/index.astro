---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  "Python",
  "SQL",
  "Go",
  "Databricks",
  "Airflow",
  "AWS",
  "Docker",
  "PostgreSQL",
  "FastAPI",
  "Flask",
];

---

<BaseLayout
  title="Mario Briseño — Senior Software Engineer"
  description="Mario Briseño is a senior software engineer based in Monterrey, Mexico, focused on systems and platforms."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="page-shell">
    <header class="site-header">
      <a class="identity" href="/" aria-label="Mario Briseño, home">
        <strong>Mario Briseño</strong>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#expertise">Expertise</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="about" aria-labelledby="hero-title">
        <div>
          <h1 id="hero-title">Senior Software Engineer</h1>
          <p class="intro">
            Senior software engineer with 8+ years of experience in backend
            development, data pipelines, workflow orchestration, APIs, and cloud
            infrastructure.
          </p>
          <div class="actions">
            <a class="button button-primary" href="#experience">View experience</a>
            <a class="button" href="/Mario-Briseno-CV.pdf" download>Download CV</a>
          </div>
        </div>

        <aside class="hero-aside" aria-label="Profile details">
          <div class="fact-grid">
            <div class="fact"><small>Based in</small><span>Monterrey, Mexico</span></div>
            <div class="fact"><small>Focus</small><span>Systems &amp; platforms</span></div>
          </div>
        </aside>
      </section>

      <div class="lower-grid">
        <section id="experience" aria-labelledby="experience-title">
          <div class="section-head">
            <h2 id="experience-title">Selected experience</h2>
            <small>Recent work</small>
          </div>

          <article class="experience-item">
            <time datetime="2024-10/2026-03">2024—2026</time>
            <div>
              <h3>PwC</h3>
              <p>
                Worked on a distributed data platform for cryptocurrency audit and
                reporting, including orchestration, Airflow workflows, Databricks
                pipelines, and Python integrations.
              </p>
            </div>
          </article>

          <article class="experience-item">
            <time datetime="2021-03/2024-06">2021—2024</time>
            <div>
              <h3>KU Leuven / Effex</h3>
              <p>
                Owned the backend, AWS infrastructure, deployments, and data layer for
                a SaaS platform for mathematical optimization models.
              </p>
            </div>
          </article>
        </section>

        <section class="expertise" id="expertise" aria-labelledby="expertise-title">
          <div class="section-head">
            <h2 id="expertise-title">Working set</h2>
            <small>Tools</small>
          </div>
          <ul class="tech-grid" aria-label="Technologies">
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
        </section>
      </div>

      <section class="background" aria-labelledby="background-title">
        <div class="section-head background-heading">
          <h2 id="background-title">Background</h2>
          <small>Education &amp; languages</small>
        </div>
        <div class="background-grid">
          <div>
            <p class="background-label">Education</p>
            <h3>Universidad Autónoma de Nuevo León</h3>
            <p>Bachelor of Engineering in Mechatronics · 2012—2017</p>
          </div>
          <div>
            <p class="background-label">Languages</p>
            <div class="language-list">
              <div>
                <h3>Spanish</h3>
                <p>Native</p>
              </div>
              <div>
                <h3>English</h3>
                <p>C2</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <div>
          <h2 id="contact-title">Contact</h2>
        </div>
        <div class="contact-links">
          <a href="mailto:mario.briseno7@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/mbz7/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/marioabz" target="_blank" rel="noreferrer">GitHub</a>
          <a href="/Mario-Briseno-CV.pdf" download>CV</a>
        </div>
      </section>
    </main>

    <footer>
      <span>Mario Briseño</span>
      <span>Senior Software Engineer</span>
    </footer>
  </div>
</BaseLayout>
